# ============ 复制这个文件为 .env，再填入你自己的值 ============
# 命令：cp .env.example .env     （Windows: Copy-Item .env.example .env）
# .env 已经在 .gitignore 里，不会被提交

# --- 服务 ---
PORT=3000

# --- 大模型（任务4 / 任务5）---
# 到 https://platform.deepseek.com 申请，形如 sk-xxxxxxxx
# 留空也能启动：清单功能全部可用，只有 AI 助手会提示「未配置 Key」
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 本地调试用：让它指向 mock 服务，不花钱、不联网也能演示流式和工具调用
# LLM_BASE_URL=http://127.0.0.1:5010
# LLM_API_KEY=mock-key

# --- 跨域白名单（任务3 的 CORS）---
# 逗号分隔。部署到 Vercel 后，把前端域名加进来
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- 数据 ---
DB_PATH=./data/app.db
# 启动时若表为空，自动播种 3 条演示数据（免费平台清盘后靠它恢复）
SEED=1

# --- 工具调用 ---
# 模型最多连续调用几轮工具，防止死循环
MAX_TOOL_ROUNDS=3
