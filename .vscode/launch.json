{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试服务端（server/app.js）",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/app.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "envFile": "${workspaceFolder}/.env",
      "restart": true
    }
  ]
}
