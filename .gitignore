# ---------- 依赖 ----------
node_modules/

# 本地 npm 缓存（沙箱环境用，正常开发不需要）
.npm-cache/

# ---------- 环境变量 ----------
# Key 绝不能进代码库（任务书坑二）
.env
.env.local
.env.*.local

# ---------- 运行时数据 ----------
# SQLite 数据库文件，不进仓库（重启会重新播种演示数据）
data/
*.db
*.db-shm
*.db-wal

# ---------- 日志与系统文件 ----------
*.log
.DS_Store
Thumbs.db

# ---------- 编辑器 ----------
# .vscode 里的 launch.json / settings.json 是有用的调试配置，故意提交
.idea/
*.swp

# ---------- 部署平台 ----------
.vercel
